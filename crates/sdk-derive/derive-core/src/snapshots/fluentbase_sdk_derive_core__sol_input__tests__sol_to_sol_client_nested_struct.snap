#[derive(::fluentbase_sdk::codec::Codec, Debug, Clone, PartialEq, Eq)]
pub struct Inner {
    pub x: U256,
}
#[derive(::fluentbase_sdk::codec::Codec, Debug, Clone, PartialEq, Eq)]
pub struct Outer {
    pub inner: Inner,
    pub note: String,
}
#[client(mode = "solidity")]
pub trait IProgram {
    #[state_mutability("view")]
    fn ping(&self, input: Outer) -> Outer;
}
